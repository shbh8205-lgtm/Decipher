# Anthropic is tried first; keep API keys private and server-side.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gemini fallback credentials.
GEMINI_API_KEY=
# Optional second Gemini key.
GEMINI_API_KEY_BACKUP=
# Optional final fallback. Select a vision model that supports JSON schema output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash

# Required for persistent sessions; use a long, random value.
SESSION_SECRET=

# Set either APP_USERS or APP_PASSWORD_HASH. Values must be bcrypt hashes.
# APP_USERS=lab-user:$2b$12$...
# APP_PASSWORD_HASH=$2b$12$...

# Store this on a persistent, access-controlled volume in deployment.
# DATA_DIR=./data

# Show the sample-data-only banner in demo deployments.
DEMO_BANNER=false

# Maximum upload size and pages per form.
MAX_UPLOAD_MB=25
MAX_PAGES=60
